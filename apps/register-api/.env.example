# Register service (Java) database settings.
#
# The default "local" profile needs none of these when the local Supabase stack is running: it connects to
# jdbc:postgresql://127.0.0.1:54322/postgres as postgres/postgres. Copy this file to .env and set the three
# values to use a different PostgreSQL. The automated tests ignore them and start their own PostgreSQL.
#
# Every other profile (dev, staging, prod) refuses to start without all three:
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev
#
# A plain local PostgreSQL:
# REGISTER_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/postgres
# REGISTER_DATABASE_USERNAME=postgres
# REGISTER_DATABASE_PASSWORD=postgres
#
# Hosted Supabase: use the "Session pooler" connection details (port 5432), with sslmode=require.

# REGISTER_DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# REGISTER_DATABASE_USERNAME=postgres.<project-ref>
# REGISTER_DATABASE_PASSWORD=<database-password>

# Token signing secret shared with the inspection API (at least 32 bytes). Not needed for the "local" profile,
# which uses a built-in development value that the inspection API also falls back to.
# JWT_SECRET=<same value as the inspection API's JWT_SECRET>
