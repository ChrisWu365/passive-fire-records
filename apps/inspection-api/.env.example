PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=

# PostgreSQL that holds the inspection records (schema "inspection"). For local development, the local
# Supabase stack works as is.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# PostgreSQL the database tests may create and drop schemas in. Each run uses its own throwaway schema,
# so it can be the same database as DATABASE_URL. "npm test" fails without it.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Address of the register service (Java).
REGISTER_SERVICE_URL=http://localhost:8080
