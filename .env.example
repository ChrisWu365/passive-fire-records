# Register service (Java) database settings.
#
# Copy this file to .env and fill in the values to run the service against Supabase PostgreSQL:
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev
#
# The default "local" profile and all automated tests ignore these values and use an in-memory database.
# Leave a line commented out to keep the in-memory fallback; do not leave it present but empty.
#
# Use the Supabase "Session pooler" connection details (port 5432), with sslmode=require.

# REGISTER_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# REGISTER_DB_USERNAME=postgres.<project-ref>
# REGISTER_DB_PASSWORD=<database-password>
